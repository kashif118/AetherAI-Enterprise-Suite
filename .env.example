# Copy to `.env.local` and fill in when a backend is connected.
# `.env*` files are git-ignored; this example file is the only one committed.

# Base URL of the AetherAI API. Read by services/api-client.ts once the mock
# `request()` implementation is swapped for `fetch()`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Public site URL, used for absolute metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
